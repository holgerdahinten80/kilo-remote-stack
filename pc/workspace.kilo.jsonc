{
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "*": "deny",
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "bash": { "*": "deny", "git *": "allow", "npm *": "allow", "node *": "allow", "python *": "allow", "dir*": "allow", "type *": "allow", "echo *": "allow" },
    "external_directory": "deny"
  }
}