# Beispielkonfiguration fuer /etc/wake/config.env
# Rechte: root:waker 0640. WAKE_TOKEN wird bei der Installation zufaellig erzeugt.

WAKE_TOKEN=<zufaellig-erzeugtes-token>
WG_INTERFACE=wg-firma
RELAY_URL=http://192.168.10.146/wol.php
TARGET_MAC=BC:E9:2F:9B:EB:DC
TARGET_IP=192.168.50.56
TARGET_PORT=3389
DRY_RUN=1
COOLDOWN_SECONDS=60
VPN_WAIT_SECONDS=20
RELAY_TIMEOUT_SECONDS=10
PRECHECK_TARGET=1
LISTEN=127.0.0.1:8891
