# Beispielkonfiguration fuer /etc/kilo-bridge/config.env
# Rechte: root:bridge 0640. Tokens werden bei der Installation zufaellig erzeugt.
# Der Submit-Token liegt zusaetzlich in /etc/kilo-submit.token (root:rdc 0640).

SUBMIT_TOKEN=<zufaellig>
AGENT_TOKEN=<zufaellig>
LISTEN=127.0.0.1:8892
DB_PATH=/var/lib/kilo-bridge/queue.db
MAX_INSTRUCTION=8192
MAX_PENDING=100
LEASE_SECONDS=120
RUNNING_TIMEOUT_SECONDS=3600
MAX_ATTEMPTS=5
HEARTBEAT_SECONDS=15
SUBMIT_RATE_PER_MIN=10
IDEMPOTENCY_TTL_DAYS=7
WAKE_URL=http://127.0.0.1:8891/wake
WAKE_TOKEN=<wake-token-aus-/etc/wake/config.env>
WAKE_AFTER_SECONDS=10
WAKE_COOLDOWN_SECONDS=300
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ON_SUBMIT=0
TELEGRAM_RESULT_CHARS=400
TELEGRAM_TIMEOUT_SECONDS=10
