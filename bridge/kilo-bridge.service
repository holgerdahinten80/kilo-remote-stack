[Unit]
Description=Kilo-Bridge (Auftragsqueue fuer Kilo Code)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bridge
Group=bridge
ExecStart=/usr/local/bin/kilo-bridge.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/kilo-bridge
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes

[Install]
WantedBy=multi-user.target
