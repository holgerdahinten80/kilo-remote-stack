#!/usr/bin/env python3
"""Reicht einen Kilo-Code-Auftrag bei der lokalen Bridge ein.

Der Auftrag wird als Text uebergeben (Argument oder stdin). Es gibt keine
Moeglichkeit, Ziel, Interface oder Kommandos zu waehlen.
"""

import json
import sys
import urllib.error
import urllib.request

TOKEN_FILE = "/etc/kilo-submit.token"
URL = "http://127.0.0.1:8892/jobs"
MAX_INSTRUCTION = 8192


def read_token():
    with open(TOKEN_FILE, encoding="utf-8") as handle:
        token = handle.read().strip()
    if len(token) < 32:
        raise SystemExit("Submit-Token fehlt oder ist zu kurz")
    return token


def submit(instruction):
    body = json.dumps({"instruction": instruction, "client": "chatgpt-rdc"}).encode("utf-8")
    request = urllib.request.Request(URL, data=body, method="POST")
    request.add_header("Authorization", "Bearer " + read_token())
    request.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(request, timeout=15) as response:
            return response.status, json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        try:
            return exc.code, json.loads(exc.read().decode("utf-8"))
        except Exception:
            return exc.code, {"status": "error", "message": str(exc)}
    except urllib.error.URLError as exc:
        return 0, {"status": "error", "message": f"Bridge nicht erreichbar: {exc.reason}"}


def main(argv):
    text = " ".join(argv[1:]).strip() if len(argv) > 1 else sys.stdin.read().strip()
    if not text:
        print("Kein Auftrag uebergeben (Argument oder stdin erwartet)", file=sys.stderr)
        return 2
    if len(text) > MAX_INSTRUCTION:
        print(f"Auftrag zu lang (max {MAX_INSTRUCTION} Zeichen)", file=sys.stderr)
        return 2
    code, data = submit(text)
    print(json.dumps({"http": code, **data}, ensure_ascii=False))
    return 0 if 200 <= code < 300 else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
